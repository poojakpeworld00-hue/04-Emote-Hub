<?xml version="1.0" encoding="utf-8"?>
<!-- Home, Claude Design "Skin Hub Variants" Cyan Dark: greeting header, featured Characters banner, round category
     icons, 2-column tools grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sh_bg">

    <View
        android:id="@+id/glow"
        android:layout_width="@dimen/_350sdp"
        android:layout_height="@dimen/_240sdp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_minus60sdp"
        android:layout_marginEnd="@dimen/_minus50sdp"
        android:background="@drawable/bg_corner_glow" />

<LinearLayout
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_17sdp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:background="@drawable/bg_avatar"
                android:fontFamily="@font/brand_extrabold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/home_monogram"
                android:textColor="@color/sh_on_primary"
                android:textSize="@dimen/_12ssp"
                app:fontFamily="@font/brand_extrabold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_welcome"
                    android:textColor="@color/sh_muted"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:id="@+id/headline"
                    style="@style/SH.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="@string/home_style"
                    android:textAlignment="viewStart"
                    android:textSize="@dimen/_15ssp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="@dimen/_33sdp"
                android:layout_height="@dimen/_33sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/bg_round_card"
                android:contentDescription="@string/settings"
                android:padding="@dimen/_9sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/sh_text" />
        </LinearLayout>

        <!-- Featured Characters banner. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tileCharacters"
            style="@style/SH.Bento"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_110sdp"
            android:layout_marginTop="@dimen/_12sdp"
            app:cardBackgroundColor="@color/sh_card"
            app:cardCornerRadius="@dimen/_15sdp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:layout_width="@dimen/_125sdp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_feature_wash" />

                <ImageView
                    android:id="@+id/tileCharactersArt"
                    android:layout_width="@dimen/_91sdp"
                    android:layout_height="@dimen/_106sdp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitEnd"
                    android:src="@drawable/ch_alok" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_13sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/brand_extrabold"
                        android:letterSpacing="-0.02"
                        android:text="@string/cat_characters"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_16ssp"
                        app:fontFamily="@font/brand_extrabold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cat_characters_sub"
                        android:textColor="@color/sh_muted"
                        android:textSize="@dimen/_10ssp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_28sdp"
                        android:background="@drawable/bg_cta_pill"
                        android:fontFamily="@font/brand_bold"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:paddingHorizontal="@dimen/_13sdp"
                        android:text="@string/home_explore"
                        android:textColor="@color/sh_on_primary"
                        android:textSize="@dimen/_10ssp"
                        app:fontFamily="@font/brand_bold" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Categories: round icons, 3 per row. -->
        <LinearLayout
            android:id="@+id/cats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/catCharacters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@drawable/bg_round_card">

                        <ImageView
                            android:id="@+id/catCharactersArt"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ch_alok" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/brand_semibold"
                        android:maxLines="1"
                        android:text="@string/cat_characters"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_9ssp"
                        app:fontFamily="@font/brand_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileBundles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@drawable/bg_round_card">

                        <ImageView
                            android:id="@+id/tileBundlesArt"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fc_bundles2" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/brand_semibold"
                        android:maxLines="1"
                        android:text="@string/cat_bundles"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_9ssp"
                        app:fontFamily="@font/brand_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileWeapons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@drawable/bg_round_card">

                        <ImageView
                            android:id="@+id/tileWeaponsArt"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fc_weapons2" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/brand_semibold"
                        android:maxLines="1"
                        android:text="@string/cat_weapons"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_9ssp"
                        app:fontFamily="@font/brand_semibold" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp">

                <LinearLayout
                    android:id="@+id/tilePets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@drawable/bg_round_card">

                        <ImageView
                            android:id="@+id/tilePetsArt"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fc_pets2" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/brand_semibold"
                        android:maxLines="1"
                        android:text="@string/cat_pets"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_9ssp"
                        app:fontFamily="@font/brand_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileEmotes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@drawable/bg_round_card">

                        <ImageView
                            android:id="@+id/tileEmotesArt"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fc_emotes" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/brand_semibold"
                        android:maxLines="1"
                        android:text="@string/cat_emotes"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_9ssp"
                        app:fontFamily="@font/brand_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileVehicles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="@drawable/bg_round_card">

                        <ImageView
                            android:id="@+id/tileVehiclesArt"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fc_vehicles" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/brand_semibold"
                        android:maxLines="1"
                        android:text="@string/cat_vehicles"
                        android:textColor="@color/sh_text"
                        android:textSize="@dimen/_9ssp"
                        app:fontFamily="@font/brand_semibold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/toolsTitle"
            style="@style/SH.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/tools_guides"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:id="@+id/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- list_ad: moved to RC's list_ad_position at runtime. -->
        <FrameLayout
            android:id="@+id/adInline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- bottom_ad: pinned, full width, no margin. -->
    <FrameLayout
        android:id="@+id/adSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
