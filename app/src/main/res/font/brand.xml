<?xml version="1.0" encoding="utf-8"?>
<!-- DM Sans (SIL Open Font License, Copyright 2014 The DM Sans Project Authors), the font of this app's
     "Skin Hub Variants" Cyan Dark look. One variable font file; each weight picks its 'wght' instance. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/dmsans" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400"
        app:font="@font/dmsans" app:fontStyle="normal" app:fontWeight="400" app:fontVariationSettings="'wght' 400" />
    <font android:font="@font/dmsans" android:fontStyle="normal" android:fontWeight="600" android:fontVariationSettings="'wght' 600"
        app:font="@font/dmsans" app:fontStyle="normal" app:fontWeight="600" app:fontVariationSettings="'wght' 600" />
    <font android:font="@font/dmsans" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700"
        app:font="@font/dmsans" app:fontStyle="normal" app:fontWeight="700" app:fontVariationSettings="'wght' 700" />
    <font android:font="@font/dmsans" android:fontStyle="normal" android:fontWeight="800" android:fontVariationSettings="'wght' 800"
        app:font="@font/dmsans" app:fontStyle="normal" app:fontWeight="800" app:fontVariationSettings="'wght' 800" />
</font-family>
